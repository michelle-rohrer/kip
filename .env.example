# ---------------------------------------------------------------- lokal
POSTGRES_USER=calm
POSTGRES_PASSWORD=calm
POSTGRES_DB=calm
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg2://calm:calm@db:5432/calm
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=60
APP_ENV=development
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Comma-separated lists for deployment hardening
CORS_ALLOW_ORIGINS=http://localhost:5173
# Optional: Regex fuer Preview-Domains, z. B. https://volleysync-.*\.onrender\.com
# CORS_ALLOW_ORIGIN_REGEX=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
SECURE_TRANSPORT_ONLY=false

# ---------------------------------------------------- Erststart / Produktion
# Teams, die bei der Registrierung zur Auswahl stehen (kommagetrennt).
# Bewusst nur eines: eine Trainerin sieht ausschliesslich ihr eigenes Team,
# ein zweiter Eintrag teilt die Mannschaft in einen sichtbaren und einen
# unsichtbaren Teil - und das Symptom zeigt nicht auf die Ursache.
BOOTSTRAP_TEAMS=BTV Aarau F1
# Coach-Konto, das beim Start angelegt wird (Coach-Registrierung ist per API gesperrt).
# BOOTSTRAP_COACH_USERNAME=michelle
# BOOTSTRAP_COACH_PASSWORD=mindestens-8-zeichen
# BOOTSTRAP_COACH_NAME=Michelle Rohrer
# BOOTSTRAP_COACH_EMAIL=
# BOOTSTRAP_COACH_TEAM=BTV Aarau F1
# Nur zum Zuruecksetzen eines vergessenen Coach-Passworts (danach wieder entfernen):
# BOOTSTRAP_COACH_RESET_PASSWORD=false

# Testkonten (kommagetrennte Benutzernamen). Diese Spielerinnen koennen die App
# vollstaendig nutzen, erscheinen aber NICHT in der Team-Uebersicht der Trainerin
# und fliessen NICHT ins Modelltraining ein. Die Liste ist massgeblich: wer hier
# steht wird markiert, wer rausfaellt wieder entmarkiert.
BOOTSTRAP_TEST_PLAYERS=testspielerin

# Anzahl uvicorn-Worker in Produktion
WEB_CONCURRENCY=2

# ------------------------------------------- Wearables (Whoop/Oura/Health)
# Oeffentliche URLs der beiden Services. API_BASE_URL baut die OAuth-Rueckkehr-
# Adresse und die URL, an die das iPhone seine Health-Daten schickt.
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Verschluesselt die gespeicherten Whoop-/Oura-Tokens. Ohne Wert wird ein
# Schluessel aus JWT_SECRET_KEY abgeleitet. Aenderung = alle Geraete neu verbinden.
# WEARABLE_ENCRYPTION_KEY=

# Whoop: kostenlose Developer-App auf https://developer.whoop.com anlegen und
# als Redirect-URI <API_BASE_URL>/api/integrations/callback/whoop eintragen.
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=

# Oura: nur noetig, wenn die Spielerinnen sich per OAuth verbinden sollen.
# Ohne diese Werte funktioniert weiterhin der persoenliche Oura-Token.
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=

# Schuetzt POST /api/integrations/sync-all (optionaler naechtlicher Abgleich).
# CRON_SECRET=

# ML retraining scheduler (used by docker-compose retrainer service)
ML_RETRAIN_INTERVAL_SECONDS=604800
ML_MIN_REAL_ROWS=500
ML_MIN_POSITIVE_ROWS=20
ML_ALLOW_SYNTHETIC_BOOTSTRAP=true
ML_RETRAIN_ON_STARTUP=true
