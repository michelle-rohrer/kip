POSTGRES_USER=calm
POSTGRES_PASSWORD=calm
POSTGRES_DB=calm
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg2://calm:calm@db:5432/calm
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Comma-separated lists for deployment hardening
CORS_ALLOW_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
SECURE_TRANSPORT_ONLY=false

# ML retraining scheduler (used by docker-compose retrainer service)
ML_RETRAIN_INTERVAL_SECONDS=604800
ML_MIN_REAL_ROWS=500
ML_MIN_POSITIVE_ROWS=20
ML_ALLOW_SYNTHETIC_BOOTSTRAP=true
ML_RETRAIN_ON_STARTUP=true
